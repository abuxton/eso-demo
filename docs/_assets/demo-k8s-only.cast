[0.000, "o", "\r\n\u001b[0;36m╔════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[0;36m║\u001b[0m RUNNING DEMOS\r\n"]
[0.000, "o", "\u001b[0;36m╚════════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[0.000, "o", "\r\n\u001b[0;36m╔════════════════════════════════════════════════╗\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;36m║\u001b[0m DEMO 1: Pull Secrets from External Provider (k8s)\r\n"]
[0.000, "o", "\u001b[0;36m╚════════════════════════════════════════════════╝\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m This demo shows how ExternalSecrets can pull secrets from various providers\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m Provider: k8s\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m $ Apply ExternalSecrets for k8s provider\r\n"]
[0.000, "o", "\u001b[1;33m$ cd /Users/abuxton/src/github/forks/eso-demo && for file in ./ExternalSecrets/*; do\r\n    if [ -f \"$file\" ]; then\r\n        provider_store=\"${PROVIDER}-secret-store\"\r\n        cat \"$file\" | sed \"s/\\$provider-secret-store/$provider_store/g\" | kubectl apply -f - 2>/dev/null\r\n    fi\r\ndone\u001b[0m\r\n"]
[0.073, "o", "externalsecret.external-secrets.io/data-by-name-with-template created\r\n"]
[0.068, "o", "externalsecret.external-secrets.io/data-by-name created\r\n"]
[0.061, "o", "externalsecret.external-secrets.io/data-fetch-tags created\r\n"]
[0.061, "o", "externalsecret.external-secrets.io/datafrom-fetch-tags created\r\n"]
[0.064, "o", "externalsecret.external-secrets.io/datafrom-find-by-regex created\r\n"]
[0.062, "o", "externalsecret.external-secrets.io/datafrom-find-by-tags created\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m Waiting for ExternalSecrets to sync...\r\n"]
[3.013, "o", "\u001b[0;34mℹ\u001b[0m $ List ExternalSecrets\r\n"]
[0.000, "o", "\u001b[1;33m$ kubectl get externalsecret -n eso-demo\u001b[0m\r\n"]
[0.067, "o", "NAME                         STORETYPE            STORE              REFRESH INTERVAL   STATUS              READY\r\ndata-by-name                 ClusterSecretStore   k8s-secret-store"]
[0.000, "o", "   15s                SecretSyncedError   False"]
[0.000, "o", "\r\ndata-by-name-with-template"]
[0.000, "o", "   ClusterSecretStore"]
[0.000, "o", "   k8s-secret-store   15s"]
[0.000, "o", "                "]
[0.000, "o", "SecretSyncedError   False"]
[0.000, "o", "\r\ndata-fetch-tags"]
[0.000, "o", "              ClusterSecretStore   k8s-secret-store   15s                "]
[0.000, "o", "SecretSyncedError"]
[0.000, "o", "   False"]
[0.000, "o", "\r\n"]
[0.000, "o", "datafrom-fetch-tags          ClusterSecretStore"]
[0.000, "o", "   k8s-secret-store   "]
[0.000, "o", "15s                SecretSyncedError   False\r\ndatafrom-find-by-regex       ClusterSecretStore   k8s-secret-store"]
[0.000, "o", "   15s"]
[0.000, "o", "                SecretSyncedError   "]
[0.000, "o", "False\r\ndatafrom-find-by-tags        ClusterSecretStore   k8s-secret-store   15s                SecretSyncedError   False\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m Check secret values:\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m $ List synchronized secrets\r\n"]
[0.000, "o", "\u001b[1;33m$ kubectl get secret -n eso-demo\u001b[0m\r\n"]
[0.046, "o", "No resources found in eso-demo namespace.\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m Sample secret value from one of the synced secrets:\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m $ Decode and display a secret value\r\n"]
[0.000, "o", "\u001b[1;33m$ kubectl get secret data-by-name -n eso-demo -o jsonpath='{.data.secret-value}' | base64 -d 2>/dev/null || echo 'Secret value not available'\u001b[0m\r\n"]
[0.047, "o", "Error from server (NotFound): secrets \"data-by-name\" not found\r\n"]
[0.001, "o", "\u001b[0;32m✓\u001b[0m Demo 1 complete: Secrets have been pulled from k8s\r\n"]
[0.000, "o", "\r\n\u001b[0;36m╔════════════════════════════════════════════════╗\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;36m║\u001b[0m DEMO 2: Switch Providers Dynamically\r\n"]
[0.000, "o", "\u001b[0;36m╚════════════════════════════════════════════════╝\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m This demo shows how to switch between providers without changing the ExternalSecret definition\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m Available ClusterSecretStores:\r\n"]
[0.043, "o", "NAME                 AGE   STATUS                  CAPABILITIES   READY\r\nk8s-secret-store     6s    InvalidProviderConfig                  False\r\nvault-secret-store   6s    Valid                "]
[0.000, "o", "   ReadWrite      True\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m Switching data-by-name ExternalSecret to use vault-secret-store...\r\n"]
[0.045, "o", "externalsecret.external-secrets.io/data-by-name patched\r\n"]
[2.013, "o", "\u001b[0;34mℹ\u001b[0m $ Display secret value from first provider\r\n"]
[0.000, "o", "\u001b[1;33m$ kubectl get secret data-by-name -n eso-demo -o jsonpath='{.data.secret-value}' | base64 -d 2>/dev/null || echo 'Secret value not available'\u001b[0m\r\n"]
[0.099, "o", "Error from server (NotFound): secrets \"data-by-name\" not found\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m Now switching to k8s-secret-store...\r\n"]
[0.053, "o", "externalsecret.external-secrets.io/data-by-name patched\r\n"]
[2.010, "o", "\u001b[0;34mℹ\u001b[0m $ Display secret value from second provider\r\n"]
[0.000, "o", "\u001b[1;33m$ kubectl get secret data-by-name -n eso-demo -o jsonpath='{.data.secret-value}' | base64 -d 2>/dev/null || echo 'Secret value not available'\u001b[0m\r\n"]
[0.069, "o", "Error from server (NotFound): secrets \"data-by-name\" not found\r\n"]
[0.001, "o", "\u001b[0;32m✓\u001b[0m Demo 2 complete: Provider switching demonstrated\r\n"]
[0.000, "o", "\r\n\u001b[0;36m╔════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[0;36m║\u001b[0m DEMO 3: Push Secrets to External Providers\r\n"]
[0.000, "o", "\u001b[0;36m╚════════════════════════════════════════════════╝\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m This demo shows how PushSecrets can push Secrets from the cluster to external providers\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m $ Apply PushSecret and Secret resources\r\n\u001b[1;33m$ kubectl apply -f /Users/abuxton/src/github/forks/eso-demo/PushSecrets/data-by-name.yaml\u001b[0m\r\n"]
[0.092, "o", "pushsecret.external-secrets.io/data-by-name created\r\n"]
[0.011, "o", "secret/my-own-secret created\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m Waiting for PushSecret to sync...\r\n"]
[3.011, "o", "\u001b[0;34mℹ\u001b[0m $ List PushSecrets\r\n\u001b[1;33m$ kubectl get pushsecret -n eso-demo\u001b[0m\r\n"]
[0.065, "o", "NAME           AGE   STATUS\r\ndata-by-name   3s    Synced\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m $ Display the pushed secret content\r\n"]
[0.000, "o", "\u001b[1;33m$ kubectl get secret my-own-secret -n eso-demo -o jsonpath='{.data.key}' | base64 -d\u001b[0m\r\n"]
[0.056, "o", "{\"secret-key\":\"Hello KubeHuddle Toronto 2023!\"}\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m The secret has been pushed to Vault. To verify, check Vault UI or use:\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m   kubectl port-forward -n vault svc/vault 8200:8200\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m   Then navigate to Vault and look for 'my-pushed-secret'\r\n"]
[0.000, "o", "\u001b[0;32m✓\u001b[0m Demo 3 complete: Secrets have been pushed to Vault\r\n"]
[0.000, "o", "\r\n\u001b[0;36m╔════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[0;36m║\u001b[0m DEMO 4: Generate Secrets Using Generators\r\n"]
[0.000, "o", "\u001b[0;36m╚════════════════════════════════════════════════╝\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m This demo shows how to use Generators (Password and Fake) to create secrets\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m $ Apply Generator resources\r\n"]
[0.000, "o", "\u001b[1;33m$ kubectl apply -f /Users/abuxton/src/github/forks/eso-demo/Generators/\u001b[0m\r\n"]
[0.092, "o", "fake.generators.external-secrets.io/fake-key created\r\n"]
[0.006, "o", "externalsecret.external-secrets.io/fake created\r\n"]
[0.007, "o", "password.generators.external-secrets.io/my-password created\r\n"]
[0.010, "o", "externalsecret.external-secrets.io/my-externalsecret-password created\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m Waiting for Generators to create secrets...\r\n"]
[3.010, "o", "\u001b[0;34mℹ\u001b[0m $ List Generators\r\n\u001b[1;33m$ kubectl get fake,password -n eso-demo\u001b[0m\r\n"]
[0.080, "o", "NAME                                           AGE\r\nfake.generators.external-secrets.io/fake-key   3s\r\n"]
[0.000, "o", "\r\nNAME                                                  AGE\r\npassword.generators.external-secrets.io/my-password   3s\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m $ List generated secrets\r\n\u001b[1;33m$ kubectl get secret -n eso-demo | grep -E 'fake|password'\u001b[0m\r\n"]
[0.049, "o", "fake                 Opaque   2      3s\r\nmy-secret-password   Opaque   1      3s\r\n"]
[0.001, "o", "\u001b[0;34mℹ\u001b[0m Display generated password:\r\n"]
[0.000, "o", "\u001b[0;34mℹ\u001b[0m $ Display generated password\r\n\u001b[1;33m$ kubectl get secret my-password -n eso-demo -o jsonpath='{.data.password}' | base64 -d\u001b[0m\r\n"]
